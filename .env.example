# ─────────────────────────────────────────────────────────────
# Website (Next.js, statischer Export)
# ─────────────────────────────────────────────────────────────
# Öffentliche URL des Wartelisten-Endpunkts (Cloudflare Worker, siehe waitlist-worker/).
# Ist der Wert leer, nimmt das Formular KEINE Anmeldungen an und meldet das ehrlich.
# Kein Geheimnis: die URL ist ohnehin im Browser sichtbar.
NEXT_PUBLIC_WAITLIST_ENDPOINT=

# Kanonische Adresse der Seite (für Open Graph, Sitemap)
NEXT_PUBLIC_SITE_URL=https://stadtgarden.de

# ─────────────────────────────────────────────────────────────
# Wartelisten-Worker (NUR als Cloudflare-Secret / in waitlist-worker/.dev.vars,
# niemals hier mit echten Werten committen und nie mit NEXT_PUBLIC_ beginnen)
# ─────────────────────────────────────────────────────────────
# BREVO_API_KEY=xkeysib-...
# BREVO_LIST_ID=3
# BREVO_DOI_TEMPLATE_ID=7
# DOI_REDIRECT_URL=https://stadtgarden.de/bestaetigt/
# ALLOWED_ORIGINS=https://stadtgarden.de,https://www.stadtgarden.de
